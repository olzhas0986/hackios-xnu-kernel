+void
+IOMobileFramebuffer::completeSwap(void)
+{
+	IOLockLock(fSwapLock);
+	fSwapFirst = (fSwapFirst + 1) % SWAP_QUEUE;
+	fSwapsWaiting--;
+	fCompletedTicket++;
+	IOLockWakeup(fSwapLock, &fSwapsWaiting, true);
+	IOLockWakeup(fSwapLock, &fCompletedTicket, false);
+	IOLockUnlock(fSwapLock);
+}
