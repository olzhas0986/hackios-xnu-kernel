+			munch_scan_hud(fb->fBase, fb->fPanelWidth, fb->fPanelHeight, fb->fRowBytes,
+			    fb->fCopyNs, fb->fSwapsShown, fb->fStatScanMissed, fb->fComposeBase != NULL,
+			    fb->fMonitorBeat, fb->fFrameStage, (uint32_t)(age / NSEC_PER_MSEC));
+		}
+	}
