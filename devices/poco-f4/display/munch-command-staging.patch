+/* Re-measure with an unchanged front image: a scheduling outlier must not
+ * leave a permanent high-water budget that can never fit the TE idle window.
+ * The pending composed image is not touched, and no new pixels are presented
+ * during this measurement. Only the presenter performs full front copies.
+ */
+bool
+IOMobileFramebuffer::remeasureCopy(void)
+{
+	size_t bytes = (size_t)fRowBytes * fPanelHeight;
+	if (fProbeMemory == NULL) {
+		fProbeMemory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut, bytes, PAGE_SIZE);
+		if (fProbeMemory == NULL) return false;
+		fProbeBase = (uint8_t *)fProbeMemory->getBytesNoCopy();
+	}
+	memcpy(fProbeBase, fBase, bytes);
+	uint64_t now_ns;
+	for (unsigned sample = 0; sample < 3; sample++) {
+		uint64_t start = mach_absolute_time(), ns;
+		memcpy(fBase, fProbeBase, bytes);
+		__asm__ volatile("dsb oshst" ::: "memory");
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		if (!ns) return false;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+		munch_copy_observe(now_ns, ns);
+	}
+	fCopyNs = munch_copy_budget(now_ns);
+	hakios_tl("display: identical-front copy remeasured recent peak %llu us after missed windows\n", fCopyNs / 1000);
+	return true;
+}
