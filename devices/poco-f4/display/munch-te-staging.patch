+/* A bounded, passive TE wait. Validate the inherited ~60-Hz mode first.
+ * The pin and its mux are read only; no TLMM interrupt or display programming.
+ */
+uint64_t
+IOMobileFramebuffer::waitForTE(void)
+{
+	if (!fTEInput) return 0;
+	uint64_t edges[4], deadline, now;
+	unsigned needed = fTEPeriod ? 1 : 4, count = 0, polls = 0;
+	clock_interval_to_deadline(fTEPeriod ? 25 : 100, NSEC_PER_MSEC, &deadline);
+	unsigned previous = *fTEInput & 1;
+	do {
+		unsigned high = *fTEInput & 1;
+		now = mach_absolute_time();
+		if (high && !previous) edges[count++] = now;
+		previous = high;
+	} while (count < needed && now < deadline && ++polls < 16000000);
+	if (count != needed) {
+		if (fTEWarnings++ < 3) IOLog("MUNCH TE: missing pulse; serial staging fallback for this frame\n");
+		if (!fTEPeriod || fTEWarnings >= 3) fTEInput = NULL;
+		return 0;
+	}
+	if (!fTEPeriod) {
+		uint64_t p[3] = {edges[1]-edges[0], edges[2]-edges[1], edges[3]-edges[2]}, ns;
+		for (unsigned i = 1; i < 3; i++) for (unsigned j = i; j && p[j] < p[j-1]; j--) {
+			uint64_t t = p[j]; p[j] = p[j-1]; p[j-1] = t;
+		}
+		absolutetime_to_nanoseconds(p[1], &ns);
+		if (!munch_te_period_valid(ns)) {
+			IOLog("MUNCH TE: period %llu ns is outside the validated 60-Hz mode; staging only\n", ns);
+			fTEInput = NULL; return 0;
+		}
+		fTEPeriod = p[1];
+		IOLog("MUNCH TE: period %llu ns; transfer offset 14000 us (stock 60-Hz DT budget)\n", ns);
+	}
+	return edges[needed-1];
+}
+
+/* All layer/scaling workers have finished before this single front copy.
+ * The 14-ms phase is the stock panel's transfer-time budget, not a hardware
+ * page flip. Late/missing TE and an insufficient copy window are reported.
+ */
+void
+IOMobileFramebuffer::flushStaging(uint64_t edge)
+{
+	if (!fFront) return;
+	uint64_t delay, target = 0;
+	nanoseconds_to_absolutetime(14 * NSEC_PER_MSEC, &delay);
+	if (edge && fCopyBudget >= fTEPeriod - delay) {
+		IOLog("MUNCH TE: measured copy does not fit the transfer gap; TE pacing disabled\n");
+		fTEInput = NULL; edge = 0;
+	}
+	if (edge) {
+		target = munch_te_copy_time(edge, mach_absolute_time(), fTEPeriod, delay, fCopyBudget);
+		if (!target) {
+			edge = waitForTE();
+			if (edge) target = munch_te_copy_time(edge, mach_absolute_time(), fTEPeriod, delay, fCopyBudget);
+		}
+		if (!target && fTEWarnings++ < 3) IOLog("MUNCH TE: copy budget does not fit; serial staging fallback\n");
+	}
+	if (target) clock_delay_until(target);
+	uint64_t began = mach_absolute_time();
+	memcpy(fFront, fBase, (size_t)fRowBytes * fPanelHeight);
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint64_t elapsed = mach_absolute_time() - began;
+	if (elapsed > fCopyBudget) fCopyBudget = elapsed;
+	if (fSwapsShown < 8) {
+		uint64_t ns; absolutetime_to_nanoseconds(elapsed, &ns);
+		IOLog("MUNCH TE: front copy %llu us, phased %u\n", ns/1000, target != 0);
+	}
+}
