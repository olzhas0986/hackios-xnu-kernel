/* SPDX-License-Identifier: MIT
 * Read the exact host-built system APFS image from iosroot into claimed RAM.
 * MUNCH_SYSTEM_BYTES and MUNCH_SYSTEM_CRC32 are generated by the packer.
 * Never calls WriteBlocks, FlushBlocks or the loader's UFS request service.
 */
static uint32_t
munch_system_crc32(const uint8_t *data, uint64_t size)
{
    uint32_t table[256];
    for (uint32_t i = 0; i < 256; i++) {
        uint32_t value = i;
        for (unsigned bit = 0; bit < 8; bit++)
            value = (value >> 1) ^ (0xedb88320u & (0u - (value & 1)));
        table[i] = value;
    }
    uint32_t crc = 0xffffffffu;
    for (uint64_t i = 0; i < size; i++) crc = table[(crc ^ data[i]) & 255] ^ (crc >> 8);
    return ~crc;
}

static int
munch_load_iosroot(const struct payload_info *pi)
{
    const efi_guid part_guid = EFI_PARTITION_INFO_GUID, block_guid = EFI_BLOCK_IO_GUID;
    static const char16 wanted[] = u"iosroot";
    efi_handle *handles = NULL;
    uint64_t count = 0, matches = 0;
    efi_block_io *selected = NULL;
    typedef efi_status (EFIAPI *connect_fn)(efi_handle, efi_handle *, efi_device_path *, uint8_t);
    connect_fn connect = (connect_fn)BS->connect_controller;
    if (!EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &block_guid, NULL, &count, &handles))) {
        for (uint64_t i = 0; i < count; i++) connect(handles[i], NULL, NULL, 1);
        BS->free_pool(handles);
    }
    if (EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &part_guid, NULL, &count, &handles))) {
        print("MUNCH: no partition information; system NOT loaded\n"); return 0;
    }
    for (uint64_t i = 0; i < count; i++) {
        efi_partition_info *info = NULL;
        efi_block_io *bio = NULL;
        if (EFI_ERROR(BS->handle_protocol(handles[i], &part_guid, (void **)&info)) ||
            !info || info->type != 2) continue;
        unsigned n = 0;
        while (n < sizeof(wanted) / sizeof(wanted[0]) && info->name[n] == wanted[n]) n++;
        if (n != sizeof(wanted) / sizeof(wanted[0])) continue;
        matches++;
        if (!EFI_ERROR(BS->handle_protocol(handles[i], &block_guid, (void **)&bio))) selected = bio;
    }
    BS->free_pool(handles);
    if (matches != 1 || !selected || !selected->media) {
        print("MUNCH: expected exactly one readable iosroot partition, got %d\n", matches); return 0;
    }
    if (!choose_window(pi) || win_size < RESIDENT_RD_OFFSET + MUNCH_SYSTEM_BYTES + RESIDENT_RD_RESERVE) {
        print("MUNCH: not enough contiguous RAM for the system image\n"); return 0;
    }
    efi_block_media *media = selected->media;
    uint64_t base = win_base + RESIDENT_RD_OFFSET;
    uint64_t bs = media->block_size;
    if (!bs || bs > 0x100000 || 0x100000 % bs || MUNCH_SYSTEM_BYTES % bs ||
        media->last_block == ~0ULL || MUNCH_SYSTEM_BYTES / bs > media->last_block + 1 ||
        (media->io_align > 1 && (base % media->io_align || 0x100000 % media->io_align))) {
        print("MUNCH: unsupported iosroot geometry\n"); return 0;
    }
    resident_rd_size = 0;
    print("MUNCH: reading verified iOS 16.5 RAM root, %d MiB\n", MUNCH_SYSTEM_BYTES >> 20);
    for (uint64_t at = 0; at < MUNCH_SYSTEM_BYTES;) {
        uint64_t size = MUNCH_SYSTEM_BYTES - at;
        if (size > 0x100000) size = 0x100000;
        efi_status status = selected->read_blocks(selected, media->media_id, at / bs,
                                                size, (void *)(uintptr_t)(base + at));
        if (EFI_ERROR(status)) {
            print("MUNCH: iosroot read failed at %x: %x\n", at, status); return 0;
        }
        at += size;
        if (!(at & 0x7ffffff)) print("MUNCH: read %d MiB\n", at >> 20);
    }
    const uint8_t *image = (const uint8_t *)(uintptr_t)base;
    if (image[32] != 'N' || image[33] != 'X' || image[34] != 'S' || image[35] != 'B' ||
        munch_system_crc32(image, MUNCH_SYSTEM_BYTES) != MUNCH_SYSTEM_CRC32) {
        print("MUNCH: system image CRC/magic mismatch; kernel NOT started\n"); return 0;
    }
    resident_rd_size = MUNCH_SYSTEM_BYTES;
    print("MUNCH: system image read and CRC verified; starting XNU\n");
    return 1;
}
